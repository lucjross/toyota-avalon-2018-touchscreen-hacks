#!/usr/bin/env python3
"""Control the running head unit daemon.

  headunitctl status          show the active profile
  headunitctl list            list profiles (active one marked *)
  headunitctl profile NAME    switch profile
  headunitctl reload          re-read profiles.json
"""

import socket
import sys

SOCKET_PATH = "/run/headunit.sock"

if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    print(__doc__.strip())
    sys.exit(0 if len(sys.argv) > 1 else 2)

with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
    try:
        s.connect(SOCKET_PATH)
    except OSError as exc:
        sys.exit(f"headunitctl: can't reach the daemon at {SOCKET_PATH}: {exc}")
    s.sendall((" ".join(sys.argv[1:]) + "\n").encode())
    reply = b""
    while chunk := s.recv(4096):
        reply += chunk
print(reply.decode().rstrip())
sys.exit(1 if reply.startswith(b"error") else 0)
