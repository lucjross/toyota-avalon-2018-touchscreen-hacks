[Unit]
Description=Toyota Head Unit input daemon (front-panel encoders -> profiles)
After=sound.target multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/pi/headunit_daemon.py
WorkingDirectory=/home/pi
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
